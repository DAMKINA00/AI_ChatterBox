{
  "name": "ai-chatterbox",
  "productName": "AI_ChatterBox",
  "version": "0.4.33",
  "private": true,
  "description": "Desktop agent team for Claude Code, Codex, Antigravity, Grok, DeepSeek API and Gemini web",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-unit.mjs",
    "test:ui": "electron-vite build && node scripts/e2e-settings-workers.mjs",
    "codex:schema": "node scripts/gen-codex-schema.mjs",
    "e2e:v1": "electron-vite build && node scripts/e2e-v1.mjs",
    "dist": "electron-vite build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "net.damkina.aichatterbox",
    "productName": "AI_ChatterBox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/install-aistudio.ps1",
        "to": "scripts/install-aistudio.ps1"
      }
    ],
    "asarUnpack": [
      "out/main/bridge-mcp.js",
      "out/main/antigravity-hook.js"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "AI_ChatterBox-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "playwright-core": "^1.64.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
